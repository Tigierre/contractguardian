# Database - Supabase PostgreSQL
# Development: Use Transaction pooling URL (port 6543)
# Production (Railway): Use Session pooling URL (port 5432)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://user:password@host:5432/postgres

# OpenAI API - Required for contract analysis
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxx
# Modelli (opzionali): analisi delle clausole e pre-analisi dei metadati.
OPENAI_MODEL_ANALYSIS=gpt-5.4-mini
OPENAI_MODEL_PREANALYSIS=gpt-5.4-nano
# Tetto di token in uscita per OGNI chiamata al modello (`max_completion_tokens`,
# ragionamento compreso): limita il costo massimo di una singola chiamata.
# Una risposta che supera il tetto viene troncata dal provider e l'analisi fallisce
# con un messaggio esplicito (e un avviso nei log): se succede spesso, alza il valore.
OPENAI_MAX_COMPLETION_TOKENS_ANALYSIS=16000
OPENAI_MAX_COMPLETION_TOKENS_PREANALYSIS=6000

# Supabase (optional - for future auth features)
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server Configuration (Railway auto-injects PORT)
PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=production

# --- Performance tuning — all optional, sensible defaults in code ---
# OCR of scanned PDFs: cap pages, downscale, and time-box per document.
OCR_MAX_PAGES=30
OCR_MAX_IMAGE_WIDTH=2000
OCR_TIMEOUT_MS=240000
# LLM analysis pipeline: back-pressure and per-analysis bounds.
# Max analyses running their LLM pipeline at the same time (in-process semaphore).
ANALYSIS_MAX_CONCURRENT=2
# Chunk-analysis calls run in parallel within a single analysis.
CHUNK_BATCH_SIZE=3
# Hard ceiling on chunks analyzed per contract; beyond this the summary flags truncation.
ANALYSIS_MAX_CHUNKS=40
# Overall per-analysis timeout in ms (default 10 minutes).
ANALYSIS_TIMEOUT_MS=600000
# Long-document cost control.
# Per-chunk token budget: bigger = fewer LLM calls on long docs, but too big
# makes the model miss findings. Default 8000 (was 3000); clamped 1000..24000.
ANALYSIS_MAX_CHUNK_TOKENS=8000
# Soft cap on merged-text length (chars): above it the merge returns a
# non-blocking "very long document" warning (no truncation here). Default ~600k.
ANALYSIS_MAX_TEXT_CHARS=600000

# --- Identità dal reverse proxy (forward-auth verso Authentik) ---
# L'app non ha un login proprio: sta dietro un reverse proxy con forward-auth
# (es. Traefik + outpost Authentik) che inoltra gli header `X-authentik-*`.
# Requisiti: il proxy rimuove gli `X-authentik-*` inviati dal client e l'app non è
# raggiungibile se non attraverso il proxy. In produzione, senza identità le API
# rispondono 403.
# In sviluppo (NODE_ENV != production), senza header del proxy si usa questo utente.
CG_DEV_USER=local-dev

# --- Autorizzazione admin (ripristino dal cestino, svuotamento del cestino) ---
# Il privilegio admin viene dai gruppi del JWT `X-authentik-jwt`, verificato con il
# JWKS indicato qui sotto. Non viene MAI dall'header testuale dei gruppi, e l'URL
# del JWKS non viene MAI dalla richiesta: solo da questa configurazione.
# Gruppo/i che concedono l'admin (lista separata da virgola). Vuoto = nessun admin.
CG_ADMIN_GROUP=cg-admin
# JWKS del provider OIDC dell'app in Authentik (firma + exp/nbf del JWT).
# ⚠️ Obbligatoria se CG_ADMIN_GROUP è valorizzata: senza, nessuno è admin
#    (fail-closed) e alla prima richiesta con JWT compare un avviso nei log.
AUTHENTIK_JWKS_URL=https://auth.example.com/application/o/contractguardian/jwks/
# Opzionali. Se valorizzate, il JWT DEVE contenere il claim corrispondente e deve
# coincidere; se lasciate vuote, il claim non viene controllato.
# issuer: di solito https://<authentik>/application/o/<slug-applicazione>/
AUTHENTIK_JWT_ISSUER=
# audience: di solito il Client ID del provider OAuth2/OIDC dell'app.
AUTHENTIK_JWT_AUDIENCE=
# In sviluppo (nessun proxy) concede l'admin all'utente fittizio per provare il cestino.
# Ignorata in produzione.
CG_DEV_ADMIN=false

# --- Cestino / retention dei contratti eliminati ---
# Giorni di recuperabilità prima del purge definitivo (cap di recuperabilità).
CG_TRASH_RETENTION_DAYS=20
# Intervallo minimo (minuti) tra due purge "lazy" innescati dagli accessi.
CG_TRASH_PURGE_THROTTLE_MIN=60
